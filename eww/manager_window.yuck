; Def variables to use in this manager_window ;
(defvar power_dialog_action "")

(defwidget power-dialog-widget []
  (box
    :class "manager-dimmer"
    :orientation "v"
    :space-evenly true
    :halign "fill"
    :valign "fill"
    (box
      :class "power-dialog-box"
      :orientation "v"
      :spacing 15
      :space-evenly false
      :halign "center"
      :valign "center"
      (label
        :class "power-dialog-title"
        :text {power_dialog_action == "poweroff" ? "Shutdown System" : (power_dialog_action == "reboot" ? "Reboot System" : "Log Out")})
      (box
        :class "power-dialog-buttons"
        :orientation "h"
        :spacing 10
        :halign "center"
        :space-evenly true
        (button
          :class "dialog-button-cancel"
          :onclick "eww open manager_window --toggle"
          (label :class "dialog-button-cancel-text" :text "Cancel")
        )
        (button
          :class "dialog-button-confirm"
          :onclick "sh ~/.config/eww/scripts/power_action.sh && eww open manager_window --toggle"
          (label :class "dialog-button-confirm-text" :text "Confirm")
        )
      )
    )
  )
)

(defwindow manager_window
  :monitor 1
  :geometry (geometry
    :anchor "center center"
    :width "100%"
    :height "100%"
  )
  :stacking "overlay"
  :focusable true
  (power-dialog-widget)
)